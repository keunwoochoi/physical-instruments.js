{
  "name": "physical-instruments.js",
  "version": "0.1.1",
  "description": "Physical-modeling instruments for the browser. 29 instruments, no samples, ~81 KB gzipped.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worklet": "./worklet/instruments-processor.js",
    "./wasm": "./wasm/instruments_dsp.wasm"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "worklet",
    "wasm",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "audio",
    "webaudio",
    "audioworklet",
    "physical-modeling",
    "synthesis",
    "instruments",
    "piano",
    "guitar",
    "strings",
    "midi",
    "wasm",
    "music"
  ],
  "homepage": "https://keunwoochoi.github.io/physical-instruments.js/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keunwoochoi/physical-instruments.js.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/keunwoochoi/physical-instruments.js/issues"
  }
}
