{
  "name": "physical-instruments.js-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Beautiful physical-modeled instruments for the browser \u2014 monorepo root",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "demo": "npm run build --workspaces --if-present && scripts/dev/serve.sh",
    "render": "node scripts/dev/render-demo.mjs",
    "bench": "node scripts/dev/render-demo.mjs --bench",
    "test:loop": "python3 -m unittest discover -s scripts/dev -p 'test_loop_*.py'",
    "audit:loop": "scripts/audit/loop-metrics-audit.sh",
    "loop:validate": "python3 scripts/dev/loop_campaign.py validate",
    "loop:run": "python3 scripts/dev/loop_campaign.py run",
    "loop:pilot": "python3 scripts/dev/loop_campaign.py pilot",
    "loop:stage-pilot": "python3 scripts/dev/stage_loop_pilot_refs.py",
    "test:transport-baseline": "node scripts/dev/transport-baseline.mjs verify",
    "listening:validate": "python3 scripts/dev/listening.py validate",
    "listening:analyze": "python3 scripts/dev/listening.py analyze",
    "audit:listening": "scripts/audit/listening-evidence-audit.sh",
    "loop:canonicalize-reference": "python3 scripts/dev/canonicalize_reference_receipt.py",
    "gen:instrument-ids": "python3 scripts/gen/gen_instrument_ids.py",
    "check:instrument-ids": "python3 scripts/gen/gen_instrument_ids.py --check && python3 scripts/gen/test_gen_instrument_ids.py",
    "audit:harness": "scripts/audit/harness-audit.sh",
    "audit:bundle": "scripts/audit/bundle-size-audit.sh",
    "bench:soundboard": "node scripts/dev/bench-soundboard.mjs",
    "check:install": "node scripts/dev/install-check.mjs",
    "stage:package-files": "node scripts/dev/stage-package-files.mjs",
    "check:bundlers": "node scripts/dev/bundler-check.mjs",
    "check:quickstart": "node scripts/verify/check-quickstart.mjs",
    "check:release": "scripts/release/check-release-ready.sh",
    "worktree": "python3 scripts/dev/worktree.py",
    "check:release-impact": "python3 scripts/release/check_release_impact.py",
    "test:release-impact": "python3 scripts/release/test_check_release_impact.py",
    "check:mobile": "node scripts/dev/mobile-safari-check.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "typescript": "^5.5.0"
  }
}
